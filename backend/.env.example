# Copy this file to .env and fill in real values before running the server.

NODE_ENV=development
PORT=3000

# Postgres connection string, e.g. postgres://user:pass@localhost:5432/evalhub
DATABASE_URL=postgres://evalhub:evalhub@localhost:5432/evalhub

# Set to true for managed Postgres that requires TLS (e.g. most cloud providers).
DATABASE_SSL=false

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Set to true when running behind nginx / a PaaS proxy so rate limiting sees real client IPs.
TRUST_PROXY=false

# Nebula Labs API key for `npm run import:coursebook` (ask Zain). Never commit the real key.
NEBULA_API_KEY=
# Optional import scope (defaults shown).
# NEBULA_SUBJECTS=CS
# NEBULA_TERMS=25F,26S,26F
