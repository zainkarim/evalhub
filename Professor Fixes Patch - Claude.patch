diff --git a/backend/db/migrations/005_teacher_department.sql b/backend/db/migrations/005_teacher_department.sql
new file mode 100644
index 0000000..8f5e191
--- /dev/null
+++ b/backend/db/migrations/005_teacher_department.sql
@@ -0,0 +1,49 @@
+-- Observer matching: department, not school (professor correction, 10/13 —
+-- see docs/weekly-report or the team's testing-walkthrough doc for context).
+--
+-- UTD's schools each contain several distinct departments -- e.g. the Erik
+-- Jonsson School of Engineering and Computer Science (ECS) contains six:
+-- Bioengineering, Computer Science, Electrical Engineering, Materials
+-- Science and Engineering, Mechanical Engineering, and Systems Engineering.
+-- (catalog.utdallas.edu/2026/graduate/programs/ecs). Matching observers by
+-- teachers.school alone (the only field that existed before this migration)
+-- could pair, say, a Computer Science observee with an Electrical
+-- Engineering observer, because both are "ECS" -- same school, wrong
+-- department. This migration adds the missing finer-grained field.
+--
+-- courses.subject (e.g. 'CS') already functions as a department-level course
+-- prefix, so no change is needed on the courses side -- only teachers lacked
+-- this granularity.
+
+ALTER TABLE teachers ADD COLUMN department TEXT;
+
+-- Backfill: each teacher's department is the subject they've taught most
+-- often (course_sections -> courses.subject), which is the only signal this
+-- database actually has for "what department is this person in." A teacher
+-- with no teaching history yet (brand new hire, no sections seeded) falls
+-- back to their school code so the column can still be made NOT NULL below
+-- -- that's a placeholder, not a real department, and should be corrected
+-- by hand (or at next sign-up) once real data exists for them.
+WITH most_taught_subject AS (
+  SELECT DISTINCT ON (cs.teacher_id)
+         cs.teacher_id,
+         c.subject
+    FROM course_sections cs
+    JOIN courses c ON c.id = cs.course_id
+   WHERE cs.teacher_id IS NOT NULL
+   GROUP BY cs.teacher_id, c.subject
+   ORDER BY cs.teacher_id, count(*) DESC
+)
+UPDATE teachers t
+   SET department = COALESCE(mts.subject, t.school)
+  FROM most_taught_subject mts
+ WHERE mts.teacher_id = t.id;
+
+UPDATE teachers SET department = school WHERE department IS NULL;
+
+ALTER TABLE teachers ALTER COLUMN department SET NOT NULL;
+
+CREATE INDEX teachers_department_idx ON teachers (department) WHERE is_active;
+
+COMMENT ON COLUMN teachers.department IS
+  'Department-level course prefix (e.g. CS, EE) -- the actual observer-matching key per the professor''s 10/13 correction. Distinct from school (e.g. ECS), which is too coarse: one school contains several departments.';
diff --git a/backend/db/migrations/006_multi_observer_scheduling.sql b/backend/db/migrations/006_multi_observer_scheduling.sql
new file mode 100644
index 0000000..66f92c7
--- /dev/null
+++ b/backend/db/migrations/006_multi_observer_scheduling.sql
@@ -0,0 +1,44 @@
+-- Fix #6 (professor feedback, 10/13): flip the scheduling model from "one
+-- observer confirms one of the observee's dates" to "the observee receives
+-- proposals back from several different observers and picks one date from
+-- whichever observer worked out" -- e.g. 3 candidates x 4 times each, and
+-- the observee chooses, constrained so the chosen slot doesn't double-book
+-- their own schedule (checked in the API via src/lib/availability.js, same
+-- helper used for fix #4).
+--
+-- This supersedes assessment_time_options.offered_to_teacher_id as "the one
+-- observer this whole batch went to" (migration 004's documented 9/30
+-- design) -- that column assumed exactly one observer could ever be offered
+-- a given option row. Under this fix, several observers can each be offered,
+-- and can each accept or decline, the same date/time; a new junction table
+-- records that per (option, teacher) instead of overloading one column on
+-- assessment_time_options.
+--
+-- offered_to_teacher_id itself is left in place (not dropped) for backward
+-- compatibility with any already-sent single-observer batches from before
+-- this migration; new sends use time_option_offers instead. The API no
+-- longer writes to offered_to_teacher_id.
+
+CREATE TABLE time_option_offers (
+  id          INT  GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+  option_id   INT  NOT NULL REFERENCES assessment_time_options (id) ON DELETE CASCADE,
+  teacher_id  INT  NOT NULL REFERENCES teachers (id) ON DELETE CASCADE,
+  -- 'pending' (sent, no response yet), 'accepted' (observer is willing --
+  -- this is NOT final, the observee still has to pick one), 'declined'.
+  status      TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'accepted', 'declined')),
+  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
+  updated_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
+  UNIQUE (option_id, teacher_id)
+);
+
+CREATE INDEX time_option_offers_option_idx  ON time_option_offers (option_id);
+CREATE INDEX time_option_offers_teacher_idx ON time_option_offers (teacher_id, status);
+
+CREATE TRIGGER time_option_offers_set_updated_at
+  BEFORE UPDATE ON time_option_offers
+  FOR EACH ROW EXECUTE FUNCTION set_updated_at();
+
+-- Which observer's accepted offer the observee actually finalized -- needed
+-- now that more than one teacher may have accepted the same date/time.
+ALTER TABLE assessment_time_options
+  ADD COLUMN confirmed_teacher_id INT REFERENCES teachers (id) ON DELETE SET NULL;
