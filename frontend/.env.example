# Leave unset to run the UI on the in-browser mock API (src/lib/mockServer.js).
# Point this at the Express server (backend listens on :3000 by default) once
# the endpoints in docs/api-expectations.md exist.
VITE_API_URL=http://localhost:3000/api

# Force the mock API even when VITE_API_URL is set.
VITE_USE_MOCKS=false
